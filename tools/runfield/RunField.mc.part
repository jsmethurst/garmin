//@members
    const F_BLACK = 0x000000;
    const F_WHITE = 0xFFFFFF;
    const F_ZFILL = [0xAAAAAA, 0x00AAFF, 0x55FF55, 0xFFAA00, 0xFF0000];
    private var _fHr = null;
    private var _fTimer = 0;
    private var _fDist = 0.0;
    private var _fPrevTimer = 0;
    private var _fPrevDist = 0.0;
    private var _fLapT0 = 0;
    private var _fLapD0 = 0.0;
    private var _fLapNo = 1;
    private var _fLastLap = -1.0;
    private var _fVirtT = -100000;
    private var _fZones = null;
    private var _fK = 1.0;
    private var _fOx = 0.0;
    private var _fOy = 0.0;
    private var _fFg = 0x000000;
    private var _fLab = 0x555555;
    private var _fLine = 0xAAAAAA;
//@code
    // ===== Run field: timer, heart rate (zone colour), distance, lap / average / last-lap pace =====

    function fldInit() as Void {
        _fZones = [95, 114, 133, 152, 171, 190];
        var z = UserProfile.getHeartRateZones(UserProfile.HR_ZONE_SPORT_RUNNING);
        if (z != null && z.size() >= 6) { _fZones = z; }
    }

    function fldReset() as Void {
        _fTimer = 0;
        _fDist = 0.0;
        _fPrevTimer = 0;
        _fPrevDist = 0.0;
        _fLapT0 = 0;
        _fLapD0 = 0.0;
        _fLapNo = 1;
        _fLastLap = -1.0;
        _fVirtT = -100000;
    }

    // called every second with the activity data
    function fldCompute(info as Activity.Info) as Void {
        _fHr = info.currentHeartRate;
        var t = (info.timerTime != null) ? info.timerTime : 0;
        var d = (info.elapsedDistance != null) ? info.elapsedDistance : 0.0;
        if (FLD_AUTO && d >= _fLapD0 + FLD_LAP_M && d > _fPrevDist) {
            // crossed a lap mark since the previous second: interpolate the exact crossing time
            var mark = _fLapD0 + FLD_LAP_M;
            var f = (mark - _fPrevDist) / (d - _fPrevDist);
            var tc = _fPrevTimer + (f * (t - _fPrevTimer)).toNumber();
            fldEndLap(tc, mark);
            _fVirtT = t;
        }
        _fTimer = t;
        _fDist = d;
        _fPrevTimer = t;
        _fPrevDist = d;
    }

    // Lap button (or the watch's own Auto Lap)
    function fldLap() as Void {
        if (_fTimer - _fVirtT < 3000) { return; }   // the watch lapped right after our own auto lap: ignore the duplicate
        fldEndLap(_fTimer, _fDist);
    }

    function fldEndLap(tEnd as Number, dEnd as Float) as Void {
        var dist = dEnd - _fLapD0;
        if (dist >= 20.0) {
            _fLastLap = ((tEnd - _fLapT0) / 1000.0) / (dist / 1000.0);
        }
        _fLapT0 = tEnd;
        _fLapD0 = dEnd;
        _fLapNo += 1;
    }

    private function fldLapPace() as Float {
        var d = _fDist - _fLapD0;
        if (d < 20.0) { return -1.0; }
        return ((_fTimer - _fLapT0) / 1000.0) / (d / 1000.0);
    }

    private function fldAvgPace() as Float {
        if (_fDist < 20.0) { return -1.0; }
        return (_fTimer / 1000.0) / (_fDist / 1000.0);
    }

    private function fldPace(secPerKm as Float) as String {
        if (secPerKm < 0.0 || secPerKm > 3599.0) { return "--:--"; }
        var s = (secPerKm + 0.5).toNumber();
        return (s / 60).format("%d") + ":" + (s % 60).format("%02d");
    }

    private function fldTime(ms as Number) as String {
        var s = ms / 1000;
        var h = s / 3600;
        var m = (s % 3600) / 60;
        var sec = s % 60;
        if (h > 0) { return h.format("%d") + ":" + m.format("%02d") + ":" + sec.format("%02d"); }
        return m.format("%02d") + ":" + sec.format("%02d");
    }

    // 0 = below zone 1, 1..5 = zones
    private function fldZone(hr) as Number {
        if (hr == null || _fZones == null) { return 0; }
        var z = 0;
        for (var i = 0; i < 5; i++) {
            if (hr >= _fZones[i]) { z = i + 1; }
        }
        return z;
    }

    private function fx(x as Float) as Number { return (_fOx + x * _fK).toNumber(); }
    private function fy(y as Float) as Number { return (_fOy + y * _fK).toNumber(); }

    private function fldLine(dc as Dc, x1 as Float, y1 as Float, x2 as Float, y2 as Float) as Void {
        dc.drawLine(fx(x1), fy(y1), fx(x2), fy(y2));
    }

    // small grey caption
    private function fldLabel(dc as Dc, s as String, x as Float, y as Float, color as Number) as Void {
        dc.setColor(color, Graphics.COLOR_TRANSPARENT);
        dc.drawText(fx(x), fy(y), Graphics.FONT_XTINY, s, Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER);
    }

    // big number in a system number font (those fonts have no "-", so placeholders use a text font)
    private function fldNum(dc as Dc, s as String, x as Float, y as Float, font, color as Number) as Void {
        var f = (s.find("-") != null) ? Graphics.FONT_MEDIUM : font;
        dc.setColor(color, Graphics.COLOR_TRANSPARENT);
        dc.drawText(fx(x), fy(y), f, s, Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER);
    }

    // ---------- the screen ----------

    function fldDraw(dc as Dc) as Void {
        var w = dc.getWidth();
        var h = dc.getHeight();
        _fK = ((w < h) ? w : h) / 280.0;
        _fOx = w / 2.0 - 140.0 * _fK;
        _fOy = h / 2.0 - 140.0 * _fK;

        // light, dark, or follow the activity's screen colour like the native data screens
        var dark = (FLD_THEME == 2) || (FLD_THEME == 1 && getBackgroundColor() == Graphics.COLOR_BLACK);
        _fFg = dark ? F_WHITE : F_BLACK;
        _fLab = dark ? 0xAAAAAA : 0x555555;
        _fLine = dark ? 0x555555 : 0xAAAAAA;
        dc.setColor(_fFg, dark ? F_BLACK : F_WHITE);
        dc.clear();

        // heart-rate cell filled with the zone colour
        var zone = fldZone(_fHr);
        var hrFg = _fFg;
        var hrLab = _fLab;
        if (zone >= 1) {
            dc.setColor(F_ZFILL[zone - 1], F_ZFILL[zone - 1]);
            dc.fillRectangle(fx(20.0), fy(77.0), (118.0 * _fK).toNumber(), (60.0 * _fK).toNumber());
            hrFg = (zone == 5) ? F_WHITE : F_BLACK;
            hrLab = hrFg;
        }

        // dividers
        dc.setPenWidth(1);
        dc.setColor(_fLine, Graphics.COLOR_TRANSPARENT);
        fldLine(dc, 16.0, 76.0, 264.0, 76.0);
        fldLine(dc, 8.0, 138.0, 272.0, 138.0);
        fldLine(dc, 14.0, 206.0, 266.0, 206.0);
        fldLine(dc, 140.0, 76.0, 140.0, 138.0);
        fldLine(dc, 140.0, 206.0, 140.0, 252.0);

        // timer
        fldLabel(dc, "TIMER", 140.0, 21.0, _fLab);
        fldNum(dc, fldTime(_fTimer), 140.0, 51.0, Graphics.FONT_NUMBER_MEDIUM, _fFg);

        // heart rate and distance
        fldLabel(dc, (zone >= 1) ? "HR  ZONE " + zone.format("%d") : "HEART RATE", 80.0, 88.0, hrLab);
        fldNum(dc, (_fHr == null) ? "--" : _fHr.format("%d"), 80.0, 116.0, Graphics.FONT_NUMBER_MILD, hrFg);
        fldLabel(dc, "DISTANCE KM", 200.0, 88.0, _fLab);
        fldNum(dc, (_fDist / 1000.0).format("%.2f"), 200.0, 116.0, Graphics.FONT_NUMBER_MILD, _fFg);

        // current lap pace: the big one
        fldLabel(dc, "LAP " + _fLapNo.format("%d") + "   " + ((_fDist - _fLapD0) / 1000.0).format("%.2f") + " KM", 140.0, 148.0, _fLab);
        fldNum(dc, fldPace(fldLapPace()), 140.0, 180.0, Graphics.FONT_NUMBER_HOT, _fFg);

        // average pace and last lap pace
        fldLabel(dc, "AVG PACE", 98.0, 217.0, _fLab);
        fldNum(dc, fldPace(fldAvgPace()), 98.0, 237.0, Graphics.FONT_NUMBER_MILD, _fFg);
        fldLabel(dc, "LAST LAP", 182.0, 217.0, _fLab);
        fldNum(dc, fldPace(_fLastLap), 182.0, 237.0, Graphics.FONT_NUMBER_MILD, _fFg);
    }
